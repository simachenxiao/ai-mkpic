# 上游地址（OpenAI Images API 兼容）
IMAGE_BASE_URL=https://lingsuan.org/v1

# API Key（生图分组）
IMAGE_API_KEY=sk-你的key

# 本地端口
PORT=8787

# 上游超时（毫秒）
IMAGE_TIMEOUT_MS=300000

# 上游偶发回空图时的自动重试次数
IMAGE_RETRY=2

# 对话模型：只用于「输入物品名称 → 自动写主体描述 + 估算实物尺寸」
# 同一个 lingsuan key 就能用 gpt-6-luna / gpt-5.6-luna；也可以换成 deepseek
LLM_BASE_URL=https://lingsuan.org/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT_MS=90000
