# 上游地址（OpenAI Images API 兼容）
IMAGE_BASE_URL=https://www.ccsub.net/api/v1

# API Key（生图分组）
IMAGE_API_KEY=sk-你的key

# 本地端口
PORT=8787

# 上游超时（毫秒）
IMAGE_TIMEOUT_MS=300000

# 上游偶发回空图时的自动重试次数
IMAGE_RETRY=2

# 对话模型：只用于「输入物品名称 → 自动写主体描述 + 估算实物尺寸」
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的deepseek-key
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=90000
